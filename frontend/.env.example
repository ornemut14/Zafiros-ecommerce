# Base de datos Postgres (Neon o Supabase).
# La API y la tienda se sirven desde el mismo dominio de Vercel, asi que
# VITE_API_URL queda vacio a proposito: las rutas /api/* son relativas.
VITE_API_URL=

# Cloudinary (para subir fotos de producto desde el panel de admin)
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset_sin_firma

# Estas dos NO se exponen al navegador: solo las lee el backend serverless.
# Van configuradas en el panel de Vercel (Settings > Environment Variables),
# en la seccion Production. Nunca subirlas a git.
#
#   DATABASE_URL=postgresql://usuario:password@host/neondb?sslmode=require
#   JWT_SECRET=una-frase-larga-y-secreta-que-inventes