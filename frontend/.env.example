# URL base de la API de PHP (backend). Producción en InfinityFree (HTTPS):
VITE_API_URL=https://zafirosjoyas.site.je/backend-php/api

# Desarrollo local (XAMPP): descomentá esta línea y comentá la de arriba
# VITE_API_URL=http://localhost/joyeria/backend-php/api

# Si corrés PHP con el servidor built-in (php -S localhost:8000 -t backend-php/api):
# VITE_API_URL=http://localhost:8000

# Cloudinary (para subir fotos de producto desde el panel de admin)
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset_sin_firma
